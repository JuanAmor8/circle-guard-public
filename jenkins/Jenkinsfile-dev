def getServiceName() {
    def jobName = env.JOB_NAME ?: 'auth'
    def parts = jobName.split('-')
    if (parts.length >= 3) {
        return parts[1]
    }
    return 'auth'
}

pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_IMAGE = "circleguard/${getServiceName()}"
        DOCKER_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT[0..7]}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Building ${env.SERVICE_NAME} from commit ${env.GIT_COMMIT[0..7]}"
                }
                checkout scm
            }
        }

        stage('Build & Compile') {
            steps {
                dir("services/circleguard-${getServiceName()}") {
                    sh """
                        ./gradlew compileKotlin compileTestKotlin --no-daemon -q
                    """
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("services/circleguard-${getServiceName()}") {
                    sh """
                        ./gradlew test --no-daemon -q
                    """
                }
            }
            post {
                always {
                    junit 'services/**/build/test-results/**/*.xml'
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    def serviceName = getServiceName()
                    sh """
                        if [ -f "services/circleguard-${serviceName}/gradlew" ]; then
                            ./gradlew dependencyCheckAnalyze --no-daemon -q || true
                        fi
                    """
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def dockerfile = "docker/Dockerfile.${getServiceName()}"
                    sh """
                        docker build -f ${dockerfile} \
                            --build-arg BUILDKIT_INLINE_CACHE=1 \
                            -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                            -t ${DOCKER_IMAGE}:latest .
                    """
                }
            }
        }

        stage('Docker Security Scan') {
            steps {
                sh """
                    docker run --rm aquasec/trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        ${DOCKER_IMAGE}:${DOCKER_TAG} || true
                """
            }
        }

        stage('Push to Registry') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'master') {
                        sh """
                            docker login -u \${DOCKER_USERNAME} -p \${DOCKER_PASSWORD}
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker push ${DOCKER_IMAGE}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy to Dev K8s') {
            when {
                anyOf { branch 'master'; branch 'develop' }
            }
            steps {
                sh """
                    kubectl config use-context docker-desktop
                    kubectl apply -f k8s/namespaces/ -n circleguard-dev 2>/dev/null || true
                    kubectl apply -f k8s/dev/ -n circleguard-dev
                    kubectl rollout status deployment/${getServiceName()} -n circleguard-dev --timeout=300s || true
                """
            }
        }

        stage('Smoke Tests') {
            steps {
                script {
                    def port = getServicePort(getServiceName())
                    sh """
                        sleep 10
                        kubectl exec -n circleguard-dev deployment/${getServiceName()} -- \
                            wget -qO- http://localhost:${port}/actuator/health || \
                            curl -sf http://localhost:${port}/actuator/health || true
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline ${getServiceName()} completed successfully!"
        }
        failure {
            echo "Pipeline ${getServiceName()} failed!"
        }
        always {
            cleanWs()
        }
    }
}

def getServicePort(String serviceName) {
    def ports = [
        'auth': '8180',
        'identity': '8083',
        'gateway': '8087',
        'form': '8086',
        'notification': '8082',
        'promotion': '8088'
    ]
    return ports[serviceName] ?: '8080'
}