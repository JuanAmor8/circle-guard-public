pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_IMAGE = "circleguard/${env.SERVICE_NAME}"
        DOCKER_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT[0..7]}"
        KUBECONFIG = credentials('kubeconfig-dev')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Building ${env.SERVICE_NAME} from commit ${env.GIT_COMMIT[0..7]}"
                }
                checkout scm
            }
        }

        stage('Build & Compile') {
            steps {
                dir("services/circleguard-${env.SERVICE_NAME}") {
                    sh """
                        ./gradlew compileKotlin compileTestKotlin --no-daemon -q
                    """
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir("services/circleguard-${env.SERVICE_NAME}") {
                    sh """
                        ./gradlew test --no-daemon -q
                    """
                }
            }
            post {
                always {
                    junit 'services/**/build/test-results/**/*.xml'
                }
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                    if [ -f "services/circleguard-${SERVICE_NAME}/gradlew" ]; then
                        ./gradlew dependencyCheckAnalyze --no-daemon -q || true
                    fi
                '''
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def dockerfile = "docker/Dockerfile.${env.SERVICE_NAME}"
                    sh """
                        docker build -f ${dockerfile} \
                            --build-arg BUILDKIT_INLINE_CACHE=1 \
                            -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                            -t ${DOCKER_IMAGE}:latest .
                    """
                }
            }
        }

        stage('Docker Security Scan') {
            steps {
                sh """
                    docker run --rm aquasec/trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 0 \
                        ${DOCKER_IMAGE}:${DOCKER_TAG} || true
                """
            }
        }

        stage('Push to Registry') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'master') {
                        sh """
                            docker login -u \${DOCKER_USERNAME} -p \${DOCKER_PASSWORD}
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker push ${DOCKER_IMAGE}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy to Dev K8s') {
            when {
                anyOf { branch 'master'; branch 'develop' }
            }
            steps {
                sh """
                    kubectl config use-context dev
                    kubectl apply -f k8s/namespaces/ -n circleguard-dev 2>/dev/null || true
                    kubectl apply -f k8s/dev/ -n circleguard-dev
                    kubectl rollout status deployment/\${SERVICE_NAME} -n circleguard-dev --timeout=300s || true
                """
            }
        }

        stage('Smoke Tests') {
            steps {
                script {
                    def port = getServicePort(env.SERVICE_NAME)
                    sh """
                        sleep 10
                        kubectl exec -n circleguard-dev deployment/\${SERVICE_NAME} -- \
                            wget -qO- http://localhost:${port}/actuator/health || \
                            curl -sf http://localhost:${port}/actuator/health || true
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline \${SERVICE_NAME} completed successfully!"
        }
        failure {
            echo "Pipeline \${SERVICE_NAME} failed!"
        }
        always {
            cleanWs()
        }
    }
}

def getServicePort(String serviceName) {
    def ports = [
        'auth': '8180',
        'identity': '8083',
        'gateway': '8087',
        'form': '8086',
        'notification': '8082',
        'promotion': '8088'
    ]
    return ports[serviceName] ?: '8080'
}