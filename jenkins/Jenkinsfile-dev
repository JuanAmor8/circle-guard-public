def getServiceName() {
    def jobName = env.JOB_NAME ?: 'auth'
    def parts = jobName.split('-')
    if (parts.length >= 3) {
        return parts[1]
    }
    return 'auth'
}

def getServicePort(String serviceName) {
    def ports = [
        'auth': '8180',
        'identity': '8083',
        'gateway': '8087',
        'form': '8086',
        'notification': '8082',
        'promotion': '8088'
    ]
    return ports[serviceName] ?: '8080'
}

pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        SERVICE_NAME = getServiceName()
        DOCKER_IMAGE = "circleguard/${SERVICE_NAME}-service"
        DOCKER_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT[0..7]}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Building ${SERVICE_NAME} from commit ${env.GIT_COMMIT[0..7]}"
                checkout scm
            }
        }

        stage('Build & Compile') {
            steps {
                sh "./gradlew :services:circleguard-${SERVICE_NAME}-service:compileKotlin :services:circleguard-${SERVICE_NAME}-service:compileTestKotlin --no-daemon -q"
            }
        }

        stage('Unit Tests') {
            steps {
                sh "./gradlew :services:circleguard-${SERVICE_NAME}-service:test --no-daemon -q"
            }
            post {
                always {
                    junit 'services/**/build/test-results/**/*.xml'
                }
            }
        }

        stage('Security Scan') {
            steps {
                sh "./gradlew dependencyCheckAnalyze --no-daemon -q || true"
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -f docker/Dockerfile.${SERVICE_NAME}-service --build-arg BUILDKIT_INLINE_CACHE=1 -t ${DOCKER_IMAGE}:${DOCKER_TAG} -t ${DOCKER_IMAGE}:latest ."
            }
        }

        stage('Docker Security Scan') {
            steps {
                sh "docker run --rm aquasec/trivy image --severity HIGH,CRITICAL --exit-code 0 ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
            }
        }

        stage('Push to Registry') {
            when {
                anyOf { branch 'master' }
            }
            steps {
                sh "docker login -u ${env.DOCKER_USERNAME} -p ${env.DOCKER_PASSWORD} && docker push ${DOCKER_IMAGE}:${DOCKER_TAG} && docker push ${DOCKER_IMAGE}:latest"
            }
        }

        stage('Deploy to Dev K8s') {
            when {
                anyOf { branch 'master'; branch 'develop' }
            }
            steps {
                sh "kubectl config use-context docker-desktop && kubectl apply -f k8s/namespaces/ 2>/dev/null || true && kubectl apply -f k8s/dev/ && kubectl rollout status deployment/${SERVICE_NAME}-service -n circleguard-dev --timeout=300s || true"
            }
        }

        stage('Smoke Tests') {
            steps {
                sh "sleep 10 && curl -sf http://localhost:${getServicePort(SERVICE_NAME)}/actuator/health || true"
            }
        }
    }

    post {
        success {
            echo "Pipeline ${SERVICE_NAME} completed successfully!"
        }
        failure {
            echo "Pipeline ${SERVICE_NAME} failed!"
        }
        always {
            cleanWs()
        }
    }
}