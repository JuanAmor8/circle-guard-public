pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_IMAGE = "circleguard/${env.SERVICE_NAME}"
        KUBECONFIG = credentials('kubeconfig-master')
        RELEASE_VERSION = ''
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '50'))
        disableConcurrentBuilds()
        timeout(time: 2, unit: 'HOURS')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.RELEASE_VERSION = getNextVersion()
                }
            }
        }

        stage('Build') {
            steps {
                dir("services/circleguard-${env.SERVICE_NAME}") {
                    sh """
                        ./gradlew clean build --no-daemon -x integrationTest -x e2eTest
                    """
                }
            }
            post {
                always {
                    junit 'services/**/build/test-results/**/*.xml'
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def dockerfile = "docker/Dockerfile.${env.SERVICE_NAME}"
                    sh """
                        docker build -f ${dockerfile} \
                            -t ${DOCKER_IMAGE}:${env.RELEASE_VERSION} \
                            -t ${DOCKER_IMAGE}:latest .
                    """
                }
            }
        }

        stage('Security Scan') {
            parallel {
                stage('OWASP Dependency Check') {
                    steps {
                        dir("services/circleguard-${env.SERVICE_NAME}") {
                            sh './gradlew dependencyCheckAnalyze --no-daemon || true'
                        }
                    }
                }
                stage('Trivy Scan') {
                    steps {
                        sh """
                            docker run --rm aquasec/trivy image \
                                --severity HIGH,CRITICAL \
                                --exit-code 0 \
                                ${DOCKER_IMAGE}:${env.RELEASE_VERSION} || true
                        """
                    }
                }
            }
        }

        stage('Push to Registry') {
            steps {
                sh """
                    docker login -u \${DOCKER_USERNAME} -p \${DOCKER_PASSWORD}
                    docker push ${DOCKER_IMAGE}:${env.RELEASE_VERSION}
                    docker push ${DOCKER_IMAGE}:latest
                """
            }
        }

        stage('Deploy to Production K8s') {
            steps {
                sh """
                    kubectl config use-context master
                    kubectl apply -f k8s/namespaces/ -n circleguard-master 2>/dev/null || true
                    kubectl set image deployment/\${SERVICE_NAME} \
                        \${SERVICE_NAME}=${DOCKER_IMAGE}:${env.RELEASE_VERSION} \
                        -n circleguard-master
                    kubectl annotate deployment/\${SERVICE_NAME} \
                        kubernetes.io/change-cause="Release ${env.RELEASE_VERSION}" \
                        -n circleguard-master
                    kubectl rollout status deployment/\${SERVICE_NAME} -n circleguard-master --timeout=600s || true
                """
            }
        }

        stage('Smoke Tests') {
            steps {
                sh """
                    sleep 30
                    curl -sf http://localhost:8087/actuator/health || true
                """
            }
        }

        stage('Generate Release Notes') {
            steps {
                sh """
                    chmod +x scripts/generate-release-notes.sh
                    ./scripts/generate-release-notes.sh \${RELEASE_VERSION} || true
                """
            }
            post {
                success {
                    archiveArtifacts artifacts: 'RELEASE_NOTES.md', allowEmptyArchive: true, fingerprint: true
                }
            }
        }

        stage('Tag & Notify') {
            steps {
                sh """
                    git config user.email "jenkins@circleguard.com" || true
                    git config user.name "Jenkins" || true
                    git tag -a v\${RELEASE_VERSION} -m "Release \${RELEASE_VERSION}" || true
                    git push origin v\${RELEASE_VERSION} || true
                """
            }
            post {
                success {
                    echo "Release \${RELEASE_VERSION} deployed to production!"
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}

def getNextVersion() {
    def lastTag = sh(
        script: 'git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0"',
        returnStdout: true
    ).trim()

    def (major, minor, patch) = lastTag.replace('v', '').split('\\.')
    return "v${major}.${minor}.${patch.toInteger() + 1}"
}